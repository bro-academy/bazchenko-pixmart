<aside class="form-sidebar">
  <div class="form-sidebar__header">
    <p class="form-sidebar__header-title">
      Filters
    </p>
    <button
      class="form-sidebar__header-button form-sidebar__close-button button button--secondary-icon filter-close"
      type="button"
    >
      {{ icon('x-close', 'icon') }}
    </button>
  </div>

  <div class="form-sidebar__body">
    <button
      class="form-sidebar__clear-button button button--secondary filter-close"
      type="button"
    >
      {{ icon('x-close', 'form-sidebar__button-icon icon') }}
      <span class="form-sidebar__button-text">Clear all filters</span>
    </button>

    <form class="form-sidebar__filter" action="url" method="get">
      <fieldset class="form-sidebar__group">
        <legend class="form-sidebar__group-title">
          Categories
        </legend>
        <div class="form-sidebar__group-wrapper">
          <label class="form-sidebar__checkbox checkbox-wrapper">
            <input
              type="checkbox"
              id="all-categories"
              name="clothing"
              value="all-categories"
              class="checkbox-input"
            />
            <span class="custom-checkbox"></span>
            All Categories
          </label>
          <label class="form-sidebar__checkbox checkbox-wrapper">
            <input
              type="checkbox"
              id="technology"
              name="clothing"
              value="technology"
              class="checkbox-input"
            />
            <span class="custom-checkbox"></span>
            Technology
          </label>
          <label class="form-sidebar__checkbox checkbox-wrapper">
            <input
              type="checkbox"
              id="travel"
              name="clothing"
              value="travel"
              class="checkbox-input"
            />
            <span class="custom-checkbox"></span>
            Travel & Tourism
          </label>
          <label class="form-sidebar__checkbox checkbox-wrapper">
            <input
              type="checkbox"
              id="health"
              name="clothing"
              value="health"
              class="checkbox-input"
            />
            <span class="custom-checkbox"></span>
            Health & Fitness
          </label>
          <label class="form-sidebar__checkbox checkbox-wrapper">
            <input
              type="checkbox"
              id="e-commerce"
              name="clothing"
              value="e-commerce"
              class="checkbox-input"
            />
            <span class="custom-checkbox"></span>
            E-Commerce
          </label>
          <label class="form-sidebar__checkbox checkbox-wrapper">
            <input
              type="checkbox"
              id="education"
              name="clothing"
              value="education"
              class="checkbox-input"
            />
            <span class="custom-checkbox"></span>
            Education
          </label>
          <label class="form-sidebar__checkbox checkbox-wrapper">
            <input
              type="checkbox"
              id="entertainment"
              name="clothing"
              value="entertainment"
              class="checkbox-input"
            />
            <span class="custom-checkbox"></span>
            Entertainment
          </label>
          <label class="form-sidebar__checkbox checkbox-wrapper">
            <input
              type="checkbox"
              id="others"
              name="clothing"
              value="others"
              class="checkbox-input"
            />
            <span class="custom-checkbox"></span>
            Others
          </label>
          <label class="form-sidebar__checkbox checkbox-wrapper">
            <input
              type="checkbox"
              id="sto"
              name="clothing"
              value="sto"
              class="checkbox-input"
            />
            <span class="custom-checkbox"></span>
            Sto to tam
          </label>
        </div>
      </fieldset>

      <fieldset class="form-sidebar__group">
        <legend class="form-sidebar__group-title">
          Format Type
        </legend>
        <div class="form-sidebar__group-wrapper">
          <label class="form-sidebar__radio radio-wrapper">
            <input
              type="radio"
              class="radio-input visually-hidden"
              name="format-type"
              value="figma"
            />
            <span class="custom-radio"></span>
            Figma
          </label>
          <label class="form-sidebar__radio radio-wrapper">
            <input
              type="radio"
              class="radio-input visually-hidden"
              name="format-type"
              value="sketch"
            />
            <span class="custom-radio"></span>
            Sketch
          </label>
          <label class="form-sidebar__radio radio-wrapper">
            <input
              type="radio"
              class="radio-input visually-hidden"
              name="format-type"
              value="adobe"
            />
            <span class="custom-radio"></span>
            Adobe XD
          </label>
          <label class="form-sidebar__radio radio-wrapper">
            <input
              type="radio"
              class="radio-input visually-hidden"
              name="format-type"
              value="photoshop"
            />
            <span class="custom-radio"></span>
            Adobe Photoshop
          </label>
          <label class="form-sidebar__radio radio-wrapper">
            <input
              type="radio"
              class="radio-input visually-hidden"
              name="format-type"
              value="illustration"
            />
            <span class="custom-radio"></span>
            Adobe Illustration
          </label>
        </div>
      </fieldset>

      <fieldset class="form-sidebar__group">
        <legend class="form-sidebar__group-title">
          Style
        </legend>
        <div class="form-sidebar__group-wrapper">
          <label class="form-sidebar__checkbox switcher">
            <input
              type="checkbox"
              name="skin"
              value="minimalist"
              class="switcher__input visually-hidden"
            />
            <span class="switcher__label"></span>
            Minimalist
          </label>
          <label class="form-sidebar__checkbox switcher">
            <input
              type="checkbox"
              name="skin"
              value="modern"
              class="switcher__input visually-hidden"
            />
            <span class="switcher__label"></span>
            Modern
          </label>
          <label class="form-sidebar__checkbox switcher">
            <input
              type="checkbox"
              name="skin"
              value="playful"
              class="switcher__input visually-hidden"
            />
            <span class="switcher__label"></span>
            Playful
          </label>
          <label class="form-sidebar__checkbox switcher">
            <input
              type="checkbox"
              name="skin"
              value="dark-mode"
              class="switcher__input visually-hidden"
            />
            <span class="switcher__label"></span>
            Dark Mode
          </label>
          <label class="form-sidebar__checkbox switcher">
            <input
              type="checkbox"
              name="skin"
              value="photocentric"
              class="switcher__input visually-hidden"
            />
            <span class="switcher__label"></span>
            Photocentric
          </label>
        </div>
      </fieldset>

      <div class="form-sidebar__price-filter">
        <p class="form-sidebar__price-title">
          Price
        </p>
        <div class="form-sidebar__slider">
          <div class="form-sidebar__filled"></div>
          <div class="form-sidebar__thumb form-sidebar__thumb--left"></div>
          <div class="form-sidebar__thumb form-sidebar__thumb--right"></div>
        </div>
        <div class="form-sidebar__price-labels">
          <span class="form-sidebar__price">€5</span>
          <span class="form-sidebar__price">€50</span>
        </div>
      </div>

      <button
        class="form-sidebar__button button button--secondary"
        type="reset"
      >
        {{ icon('x-close', 'form-sidebar__icon icon') }}
        Clear all filters
      </button>
    </form>
  </div>

  <div class="form-sidebar__bottom-wrapper">
    <button
      class="form-sidebar__bottom-button button button--primary filter-close"
      type="button"
    >
      Save
    </button>
  </div>
</aside>
